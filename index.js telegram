const TelegramBot = require('node-telegram-bot-api');
const fs = require('fs'); 
const { organizarDadosVistoria } = require('./extrator');
const { processarDocumento } = require('./processador');

const token = "7698841376:AAH4njhGD47dbtSmnuHd6ophYf8wwUobuEM";

const bot = new TelegramBot(token, { polling: true });

const sessoesAtivas = new Map();

console.clear();
console.log('--- SISTEMA CNH 2.1 ---');
console.log('✅ BOT ONLINE | Pronto para processar');

bot.on('message', async (msg) => {

    const chatID = msg.chat.id;
    const body = msg.text ? msg.text.trim() : '';

    // INÍCIO DO FLUXO: /START
    if (body.toLowerCase() === '/start') {
        sessoesAtivas.set(chatID, { etapa: 'AGUARDANDO_EAR' });
        await bot.sendMessage(chatID, '👋 Olá! Vamos começar.\n\n❓ O documento possui *EAR*? \nResponda *S* para Sim ou *N* para Não.', { parse_mode: "Markdown" });
        return;
    }

    const sessao = sessoesAtivas.get(chatID);
    if (!sessao) return;

    // ETAPA 1: CONFIRMAÇÃO DO EAR
    if (sessao.etapa === 'AGUARDANDO_EAR') {
        const resp = body.toUpperCase();
        if (resp === 'S' || resp === 'N' || resp === 'SIM' || resp === 'NAO' || resp === 'NÃO') {
            sessao.ear = (resp === 'S' || resp === 'SIM') ? 'S' : 'N';
            sessao.etapa = 'AGUARDANDO_TEXTO';
            await bot.sendMessage(chatID, `✅ EAR definido como: *${sessao.ear === 'S' ? 'SIM' : 'NÃO'}*.\n\n📝 Agora, envie o *TEXTO* da cnh.`, { parse_mode: "Markdown" });
        } else {
            await bot.sendMessage(chatID, '❌ Responda apenas *S* para Sim ou *N* para Não.', { parse_mode: "Markdown" });
        }
        return;
    }

    // ETAPA 2: CAPTURA DE TEXTO
    if (sessao.etapa === 'AGUARDANDO_TEXTO' && !msg.photo) {
        if (body.toUpperCase().includes('NOME COMPLETO:')) {
            try {
                const dadosExtraidos = organizarDadosVistoria(body, sessao.ear);
                
                const novaSessao = { 
                    ...sessao, 
                    ...dadosExtraidos, 
                    etapa: 'AGUARDANDO_FOTO' 
                };
                sessoesAtivas.set(chatID, novaSessao);

                let listaConfere = `📝 *CONFERÊNCIA DE DADOS:*\n\n`;
                listaConfere += `• *Nome:* ${dadosExtraidos.nome}\n`;
                listaConfere += `• *EAR:* ${sessao.ear === 'S' ? 'SIM' : 'NÃO'}\n`;
                listaConfere += `• *Formulário:* ${dadosExtraidos.numero}\n\n`;
                listaConfere += `📸 *Tudo certo? Envie a FOTO para gerar o PDF.*`;
                
                await bot.sendMessage(chatID, listaConfere, { parse_mode: "Markdown" });
            } catch (err) {
                await bot.sendMessage(chatID, '❌ Erro ao processar o texto.');
            }
        }
        return;
    }

    // ETAPA 3: RECEBIMENTO DA FOTO E GERAÇÃO
    if (sessao.etapa === 'AGUARDANDO_FOTO' && msg.photo) {
        try {
            await bot.sendMessage(chatID, '⏳ *Gerando PDF...*', { parse_mode: "Markdown" });

            const photo = msg.photo[msg.photo.length - 1];
            const file = await bot.getFile(photo.file_id);
            const fileUrl = `https://api.telegram.org/file/bot${token}/${file.file_path}`;

            const response = await fetch(fileUrl);
            const bufferImagem = Buffer.from(await response.arrayBuffer());

            const pdfUint8Array = await processarDocumento(bufferImagem, sessao);
            const pdfBase64 = Buffer.from(pdfUint8Array).toString('base64');

            const nomeFinal = sessao.nome.replace(/[\\/:*?"<>|]/g, '').toUpperCase();
            const pdfBuffer = Buffer.from(pdfBase64, 'base64');

            await bot.sendDocument(chatID, pdfBuffer, {
                caption: `✅ PDF gerado com sucesso!`,
                filename: `${nomeFinal}.pdf`
            });

            sessoesAtivas.delete(chatID);

        } catch (err) {
            await bot.sendMessage(chatID, `❌ Erro: ${err.message}`);
            sessoesAtivas.delete(chatID);
        }
    }

});